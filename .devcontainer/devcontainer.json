{
  "name": "ROS2 Jazzy DevContainer",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "workspaceFolder": "/workspaces/ros2_ws",

  "workspaceMount": "source=${localWorkspaceFolder}/src,target=/workspaces/ros2_ws/src,type=bind",

  "runArgs": [
    "--network=host"
  ],

  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/cyclonedds.xml,target=/cyclonedds.xml,type=bind"
  ],

  "containerEnv": {
    "ROS_DOMAIN_ID": "100",
    "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
    "CYCLONEDDS_URI": "file:///cyclonedds.xml"
  },

  "postStartCommand": "bash -c 'source /opt/ros/jazzy/setup.bash && rosdep install --from-paths src --ignore-src -r -y && colcon build --symlink-install'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  }
}