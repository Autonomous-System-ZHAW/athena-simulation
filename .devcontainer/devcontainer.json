{
    "name": "${localWorkspaceFolderBasename} ROS2 Dev-Container",
    "privileged": true,
    "remoteUser": "${localEnv:USER}",
    "build": {
        "context": "..",
        "dockerfile": "../src/IsaacSim-ros_workspaces/dockerfiles/ubuntu_24_jazzy_python_312_minimal.dockerfile",
        "args": {
            "USER": "${localEnv:USER}",
            "WS_BASENAME": "${localWorkspaceFolderBasename}"
        }
    },
    "workspaceFolder": "/home/${localEnv:USER}/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/${localEnv:USER}/ros2_ws/${localWorkspaceFolderBasename},type=bind",
    "customizations": {
        "vscode": {
            "settings": {
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true,
                    "editor.formatOnSaveMode": "file"
                },
                "files.associations": {
                    "*.rviz": "yaml",
                    "*.srdf": "xml",
                    "*.urdf": "xml",
                    "*.xacro": "xml",
                    "*.sdf": "xml",
                    "*.world": "xml",
                    "*.repos": "yaml"
                }
                
            },
            "extensions": [
                "mhutchie.git-graph",
                "ms-azuretools.vscode-docker",
                "ms-python.black-formatter",
                "ms-iot.vscode-ros",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-pylance",
                "eamodio.gitlens",
                "ranch-hand-robotics.rde-pack" // official ROS extension is deprecated, new one by Ranch Hand Robotics
            ]
        }
    },
    "containerEnv": {
        "ROS_DOMAIN_ID": "0",
        "GZ_SIM_RESOURCE_PATH": "/home/${localEnv:USER}/ros2_ws/${localWorkspaceFolderBasename}/src",
        "FASTRTPS_DEFAULT_PROFILES_FILE": "/home/${localEnv:USER}/ros2_ws/${localWorkspaceFolderBasename}/src/IsaacSim-ros_workspaces/jazzy_ws/fastdds.xml"
        
    },
    "runArgs": [
        "--hostname=${localWorkspaceFolderBasename}-devcontainer",
        "--net=host"
    ],
    "mounts": [
    ],
    "features": {
        "ghcr.io/devcontainers/features/git": {}
    },
    "postCreateCommand": "vcs import athena-simulation/src < ${containerWorkspaceFolder}/${localWorkspaceFolderBasename}/ros2.repos --recursive && sudo apt-get update && rosdep update && rosdep install --from-paths . --ignore-src --rosdistro $ROS_DISTRO -r -y && pip install --break-system-packages --no-deps -r athena-simulation/.devcontainer/requirements.txt",
    "postStartCommand": "/bin/bash -c 'rm -rf build/ install/ log/ && source /opt/ros/$ROS_DISTRO/setup.bash && colcon build --symlink-install'"
}